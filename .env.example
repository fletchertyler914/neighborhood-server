# Copy to .env and paste your key from:
# https://playit.gg/account/setup/wizard/new-account/docker/docker-name
PLAYIT_SECRET_KEY=pit-your-secret-here

# --- In-game /agent companion (Compose service: mc-agent) ---
# Required. make bootstrap generates a random value on first run.
AGENT_API_TOKEN=change-me-to-a-long-random-string
AGENT_BIND_HOST=0.0.0.0
AGENT_BIND_PORT=8787

# Whitelist is ON by default (public OSS-safe). Friends-server override:
# MC_ENFORCE_WHITELIST=false

# --- LocalLLM (host Ollama / Apple Silicon MLX) ---
# Prefer host Ollama on Mac. Do NOT use COMPOSE_PROFILES=ollama on Apple Silicon.
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
# Bake-off winner on Apple Silicon (MLX MTP): gemma4:12b-mlx
LOCAL_LLM_MODEL=gemma4:12b-mlx
LOCAL_LLM_NUM_CTX=2048
LOCAL_LLM_NUM_PREDICT=192
LOCAL_LLM_KEEP_ALIVE=30m
# Legacy aliases used by Metal validation scripts:
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b-mlx
AGENT_LOCAL_MODEL_TIMEOUT_SEC=5

# Pull on host (Apple Silicon):
#   ollama pull gemma4:12b-mlx
# Non-Mac local fallback (slower Tier B):
#   ollama pull qwen2.5:7b-instruct
#   LOCAL_LLM_MODEL=qwen2.5:7b-instruct
#   OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Template hybrid ranker ---
TEMPLATE_RANKER_MODE=hybrid
TEMPLATE_EMBEDDING_BACKEND=local
TEMPLATE_RANK_TOP_K=8
TEMPLATE_CONFIDENCE_HIGH=0.72
TEMPLATE_CONFIDENCE_MEDIUM=0.45
TEMPLATE_RANK_W_LEX=0.55
TEMPLATE_RANK_W_SEM=0.30
TEMPLATE_RANK_W_POL=0.15
TEMPLATE_RANKING_AUDIT=true

# Obsolete (soft-retired). Greenfield companion uses plugin-native WebSocket
# dispatch; do not set rcon for /agent.
# AGENT_DISPATCH_TRANSPORT=rcon
