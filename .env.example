# Copy to .env and paste your key from:
# https://playit.gg/account/setup/wizard/new-account/docker/docker-name
PLAYIT_SECRET_KEY=pit-your-secret-here

# --- In-game /agent orchestrator (Compose service: mc-agent) ---
# Plugin reads this through env:AGENT_API_TOKEN in its config.
AGENT_API_TOKEN=change-me-to-a-long-random-string
AGENT_BIND_HOST=0.0.0.0
AGENT_BIND_PORT=8787

# Local-first model. qwen2.5 is the reliable fast path on this host;
# qwen3 is kept as a bounded fallback because it can load slowly through
# Ollama's OpenAI-compatible endpoint.
# Pull once: ollama pull qwen2.5:7b-instruct && ollama pull qwen3:8b
# Other good options:
#   llama3.1:8b      - well-supported baseline
#   qwen3:14b        - upgrade if you have ~9GB RAM headroom past mc-lan
#   qwen2.5:14b      - solid tool calling, mature
# Avoid MoE/elastic models for multi-step tool chains.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FALLBACK_MODEL=qwen3:8b
AGENT_LOCAL_MODEL_TIMEOUT_SEC=15
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512

# Optional cloud fallback (hybrid routing)
# OPENAI_API_KEY=sk-...
# CLOUD_BASE_URL=https://api.openai.com/v1
# CLOUD_MODEL=gpt-4o-mini
