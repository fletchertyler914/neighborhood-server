# Copy to .env and paste your key from:
# https://playit.gg/account/setup/wizard/new-account/docker/docker-name
PLAYIT_SECRET_KEY=pit-your-secret-here

# --- In-game /agent orchestrator (Compose service: mc-agent) ---
# Required. make bootstrap generates a random value on first run.
AGENT_API_TOKEN=change-me-to-a-long-random-string
AGENT_BIND_HOST=0.0.0.0
AGENT_BIND_PORT=8787

# Whitelist is ON by default (public OSS-safe). Friends-server override:
# MC_ENFORCE_WHITELIST=false

# --- Ollama (local LLM for /agent) ---
# Path A — host Ollama (recommended on Mac Apple Silicon for Metal GPU):
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Path B — bundled Ollama Compose profile (Linux/Windows, no host install):
#   Set OLLAMA_BASE_URL=http://ollama:11434 and COMPOSE_PROFILES=ollama.
#   make bootstrap writes both when you choose the bundled profile.
# COMPOSE_PROFILES=ollama
#
# Pull once on the host: ollama pull qwen2.5:7b-instruct && ollama pull qwen3:8b
# Other good options: llama3.1:8b, qwen3:14b, qwen2.5:14b
# Avoid MoE/elastic models for multi-step tool chains.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FALLBACK_MODEL=qwen3:8b
AGENT_LOCAL_MODEL_TIMEOUT_SEC=30
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512

# Optional cloud fallback (hybrid routing)
# OPENAI_API_KEY=sk-...
# CLOUD_BASE_URL=https://api.openai.com/v1
# CLOUD_MODEL=gpt-4o-mini

# --- Template hybrid ranker (mc-agent + MCP) ---
# hybrid = lexical + local CPU embeddings; lexical_only = no semantic index
TEMPLATE_RANKER_MODE=hybrid
TEMPLATE_EMBEDDING_BACKEND=local
TEMPLATE_RANK_TOP_K=8
TEMPLATE_CONFIDENCE_HIGH=0.72
TEMPLATE_CONFIDENCE_MEDIUM=0.45
TEMPLATE_RANK_W_LEX=0.55
TEMPLATE_RANK_W_SEM=0.30
TEMPLATE_RANK_W_POL=0.15
# Append ranking decisions to data/template-ranking-audit.jsonl
TEMPLATE_RANKING_AUDIT=true
# Optional override for embedding index cache (default: agent/templates/.rank_index)
# TEMPLATE_RANK_INDEX_DIR=agent/templates/.rank_index
